# FactoryPulse Industrial IoT SaaS Configuration

# Product Branding
PRODUCT_NAME=FactoryPulse
NODE_ENV=development
PORT=5000

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=factorypulse
# Optional full connection URI:
# MYSQL_URI=mysql://root:@localhost:3306/factorypulse

# Redis & BullMQ (Optional in local dev, in-memory queue fallback enabled)
REDIS_URL=redis://localhost:6379

# Cryptographic Token Keys (Min 32 characters for production)
JWT_ACCESS_SECRET=factorypulse_super_secret_access_jwt_key_999!
JWT_REFRESH_SECRET=factorypulse_super_secret_refresh_jwt_key_888!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:5173

# Industrial Simulator Engine
SIMULATOR_ENABLED=true
SIMULATOR_TICK_INTERVAL_MS=3000

# Structured Logging Level (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info
